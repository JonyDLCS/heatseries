{
  "name": "heatseries",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:ensure",
    "dev": "next dev",
    "prebuild": "npm run db:ensure",
    "build": "next build",
    "db:build": "tsx scripts/build-db.ts --force",
    "db:ensure": "tsx scripts/build-db.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
